{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataTrip",
  "version": "0.4.1",
  "identifier": "app.datatrip.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DataTrip",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "center": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#111114",
        "theme": "Dark",
        "trafficLightPosition": {
          "x": 28,
          "y": 34
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Fast, lightweight database IDE",
    "longDescription": "DataTrip is a fast, lightweight database IDE for PostgreSQL, MySQL/MariaDB, SQLite and SQL Server.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
